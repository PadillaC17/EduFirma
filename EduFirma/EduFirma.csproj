<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EduFirma</AssemblyName>
    <Version>0.6.6</Version>
    <ApplicationIcon>Assets\EduFirma.ico</ApplicationIcon>
  </PropertyGroup>
  <Target Name="GenerateEduFirmaIcon" BeforeTargets="CoreCompile" Condition="!Exists('Assets\EduFirma.ico')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\create-icon.ps1&quot;" />
  </Target>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SimpleSign.PAdES" Version="0.9.2" />
  </ItemGroup>
  <ItemGroup Condition="Exists('Assets/MarcaEduVirtual.png')">
    <EmbeddedResource Include="Assets/MarcaEduVirtual.png" LogicalName="EduFirma.Assets.MarcaEduVirtual.png" />
  </ItemGroup>
  <ItemGroup  >
    <EmbeddedResource Include="Assets/MarcaEduVirtual.jpg" LogicalName="EduFirma.Assets.MarcaEduVirtual.jpg" />
  </ItemGroup>
</Project>
